<UserControl x:Class="SSMSPlusFlowAnalyzer.UI.FlowAnalyzerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SSMSPlusFlowAnalyzer.UI"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="White">
    <UserControl.Resources>
        <!-- Converters -->
        <local:ZeroToVisibilityConverter x:Key="ZeroToVisibleConverter" ShowWhenZero="True" />
        <local:ZeroToVisibilityConverter x:Key="ZeroToCollapsedConverter" ShowWhenZero="False" />

        <!-- Styles -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5,2"/>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Margin" Value="5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="5">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding AnalyzeCommand}" ToolTip="Analyze the active SQL editor">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="14" Margin="0,0,5,0"/>
                        <TextBlock Text="Analyze"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}" ToolTip="Refresh analysis">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" FontSize="14" Margin="0,0,5,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,5"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- Summary -->
        <Border Grid.Row="1" Background="#E8F4F8" BorderBrush="#B8D4E8" BorderThickness="0,0,0,1" Padding="10,5">
            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" FontSize="12"/>
        </Border>

        <!-- Main content -->
        <TabControl Grid.Row="2" Margin="5">
            <!-- Control Flow Tree -->
            <TabItem Header="Control Flow Tree">
                <Grid>
                    <TreeView ItemsSource="{Binding FlowNodes}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding LocationText}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock Text="No control flow found. Click 'Analyze' to analyze SQL."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="Gray"
                               Visibility="{Binding FlowNodes.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
                </Grid>
            </TabItem>

            <!-- Execution Order -->
            <TabItem Header="Execution Order">
                <Grid>
                    <ListBox ItemsSource="{Binding ExecutionOrder}" DisplayMemberPath="DisplayText">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="5"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding Node.ExecutionOrder, StringFormat='#{0}:', Mode=OneWay}"/>
                                        <Run Text="{Binding DisplayText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding LocationText}" Foreground="Gray" FontSize="11" Margin="15,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No execution order available."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="Gray"
                               Visibility="{Binding ExecutionOrder.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
                </Grid>
            </TabItem>

            <!-- Statistics -->
            <TabItem Header="Statistics">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Control Flow Constructs" Margin="5">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="BEGIN/END Blocks:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AnalysisResult.BeginEndBlocks.Count}" Margin="10,0,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="IF Statements:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AnalysisResult.IfStatements.Count}" Margin="10,0,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="WHILE Loops:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AnalysisResult.WhileLoops.Count}" Margin="10,0,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="TRY/CATCH Blocks:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AnalysisResult.TryCatchBlocks.Count}" Margin="10,0,0,0"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="GOTO Statements:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AnalysisResult.GotoStatements.Count}" Margin="10,0,0,0"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Labels:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AnalysisResult.Labels.Count}" Margin="10,0,0,0"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Maximum Nesting Level:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AnalysisResult.MaxNestingLevel}" Margin="10,0,0,0"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Errors" Margin="5" Visibility="{Binding Errors.Count, Converter={StaticResource ZeroToCollapsedConverter}}">
                            <ListBox ItemsSource="{Binding Errors}" Foreground="Red" MaxHeight="150">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>

                        <GroupBox Header="Warnings" Margin="5" Visibility="{Binding Warnings.Count, Converter={StaticResource ZeroToCollapsedConverter}}">
                            <ListBox ItemsSource="{Binding Warnings}" Foreground="Orange" MaxHeight="150">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="5">
            <TextBlock Text="SQL Flow Analyzer - Analyze BEGIN/END blocks and control-flow constructs"
                       FontSize="11"
                       Foreground="Gray"/>
        </Border>
    </Grid>
</UserControl>
