<UserControl x:Class="SSMSPlusCore.Ui.Controls.GridAggregationBar.GridAggregationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="28" d:DesignWidth="800"
             Background="#DCDCDC">
    <Border BorderThickness="0,1,0,0" BorderBrush="#A0A0A0" Padding="8,5" Background="#DCDCDC">
        <Grid x:Name="AggregatesPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- MAX -->
            <TextBlock x:Name="MaxLabel" Grid.Column="0" Margin="0,0,20,0" Foreground="#333333" Visibility="Collapsed">
                <Run FontWeight="Bold">MAX:</Run>
                <Run x:Name="MaxValue">-</Run>
            </TextBlock>

            <!-- MIN -->
            <TextBlock x:Name="MinLabel" Grid.Column="1" Margin="0,0,20,0" Foreground="#333333" Visibility="Collapsed">
                <Run FontWeight="Bold">MIN:</Run>
                <Run x:Name="MinValue">-</Run>
            </TextBlock>

            <!-- AVG -->
            <TextBlock x:Name="AvgLabel" Grid.Column="2" Margin="0,0,20,0" Foreground="#333333" Visibility="Collapsed">
                <Run FontWeight="Bold">AVG:</Run>
                <Run x:Name="AvgValue">-</Run>
            </TextBlock>

            <!-- MEDIAN -->
            <TextBlock x:Name="MedianLabel" Grid.Column="3" Margin="0,0,20,0" Foreground="#333333" Visibility="Collapsed">
                <Run FontWeight="Bold">MEDIAN:</Run>
                <Run x:Name="MedianValue">-</Run>
            </TextBlock>

            <!-- SUM -->
            <TextBlock x:Name="SumLabel" Grid.Column="4" Margin="0,0,20,0" Foreground="#333333" Visibility="Collapsed">
                <Run FontWeight="Bold">SUM:</Run>
                <Run x:Name="SumValue">-</Run>
            </TextBlock>

            <!-- COUNT -->
            <TextBlock x:Name="CountLabel" Grid.Column="5" Margin="0,0,20,0" Foreground="#333333" Visibility="Collapsed">
                <Run FontWeight="Bold">COUNT:</Run>
                <Run x:Name="CountValue">-</Run>
            </TextBlock>

            <!-- DISTINCT -->
            <TextBlock x:Name="DistinctLabel" Grid.Column="6" Margin="0,0,20,0" Foreground="#333333" Visibility="Collapsed">
                <Run FontWeight="Bold">DISTINCT:</Run>
                <Run x:Name="DistinctValue">-</Run>
            </TextBlock>

            <!-- Empty message when no selection - spans all columns -->
            <TextBlock x:Name="EmptyMessage" Grid.Column="0" Grid.ColumnSpan="8" FontStyle="Italic"
                       Foreground="#666666" VerticalAlignment="Center">
                Select cells to view statistics
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
