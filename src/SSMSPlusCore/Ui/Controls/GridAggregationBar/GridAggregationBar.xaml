<UserControl x:Class="SSMSPlusCore.Ui.Controls.GridAggregationBar.GridAggregationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#F5F5F5"
             d:DesignHeight="30" d:DesignWidth="800">
    <Border BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="8,4">
        <Grid>
            <!-- Empty state message -->
            <TextBlock x:Name="EmptyMessage"
                       Text="Select cells to view statistics"
                       Foreground="#666666"
                       VerticalAlignment="Center"
                       FontSize="11"/>

            <!-- Statistics display - horizontal layout -->
            <StackPanel x:Name="StatsPanel"
                        Orientation="Horizontal"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">

                <TextBlock FontWeight="SemiBold" Margin="0,0,4,0" FontSize="11">MAX:</TextBlock>
                <TextBlock x:Name="MaxLabel" Margin="0,0,16,0" FontSize="11"/>

                <TextBlock FontWeight="SemiBold" Margin="0,0,4,0" FontSize="11">MIN:</TextBlock>
                <TextBlock x:Name="MinLabel" Margin="0,0,16,0" FontSize="11"/>

                <TextBlock FontWeight="SemiBold" Margin="0,0,4,0" FontSize="11">AVG:</TextBlock>
                <TextBlock x:Name="AvgLabel" Margin="0,0,16,0" FontSize="11"/>

                <TextBlock FontWeight="SemiBold" Margin="0,0,4,0" FontSize="11">SUM:</TextBlock>
                <TextBlock x:Name="SumLabel" Margin="0,0,16,0" FontSize="11"/>

                <TextBlock FontWeight="SemiBold" Margin="0,0,4,0" FontSize="11">COUNT:</TextBlock>
                <TextBlock x:Name="CountLabel" Margin="0,0,16,0" FontSize="11"/>

                <TextBlock FontWeight="SemiBold" Margin="0,0,4,0" FontSize="11">DISTINCT:</TextBlock>
                <TextBlock x:Name="DistinctLabel" FontSize="11"/>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
